# Conventions pour les futures modifications ; aucun reformatage global.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
indent_size = tab

[*.md]
trim_trailing_whitespace = false
